{
  "name": "dsa2-visual-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run package:java-downloads",
    "dev": "vite",
    "prebuild": "npm run package:java-downloads",
    "build": "vite build",
    "package:graph-exercise": "node scripts/package-graph-exercise.mjs",
    "package:tra-examples": "node scripts/package-tra-examples.mjs",
    "package:java-downloads": "node scripts/package-java-downloads.mjs",
    "test": "npm run check:java-snippets && node --test",
    "preview": "vite preview",
    "format": "prettier --write src tests scripts vite.config.js eslint.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts vite.config.js eslint.config.js package.json .prettierrc.json",
    "sync:java-snippets": "node scripts/sync-java-snippets.mjs",
    "check:java-snippets": "node scripts/sync-java-snippets.mjs --check",
    "check:tra-library": "node scripts/tra-library.mjs",
    "lint": "eslint src tests scripts vite.config.js eslint.config.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "prettier": "3.8.4",
    "vite": "8.3.7"
  }
}
